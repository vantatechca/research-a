# Database
# DATABASE_URL is used at runtime by the app (Prisma adapter-pg). On Neon and
# similar serverless providers this should be the pooled connection string.
# DIRECT_URL is used by `prisma migrate`, `prisma db push`, and `prisma generate`
# (see prisma.config.ts). It MUST be the unpooled, direct connection string —
# migrations need a non-pooled session. For local Postgres they can be identical.
DATABASE_URL=postgresql://peptidebrain:peptidebrain_dev@localhost:5432/peptidebrain
DIRECT_URL=postgresql://peptidebrain:peptidebrain_dev@localhost:5432/peptidebrain

# Redis
REDIS_URL=redis://localhost:6379/0

# AI - Claude (for Brain chat)
ANTHROPIC_API_KEY=sk-ant-...

# AI - operator-facing brain chat model. Defaults to claude-sonnet-4-6 if unset.
# The worker pipeline model is set separately via CLAUDE_MODEL (defaults to
# claude-haiku-4-5-20251001).
BRAIN_MODEL=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Search API (SerpAPI or Serper.dev or Brave)
SERP_API_KEY=
SERP_API_PROVIDER=serper  # serper, serpapi, brave

# Etsy Open API
ETSY_API_KEY=

# Embeddings (OpenAI-compatible for pgvector)
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# Worker API (internal — Next.js → FastAPI)
WORKER_API_URL=http://localhost:8000

# Shared bearer token for Next.js → FastAPI calls. MUST match the same env
# var on the peptidebrain-api service. Without this, /api/scrape/trigger
# returns 503 and cannot reach the worker.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_API_TOKEN=

# Next.js public
NEXT_PUBLIC_APP_NAME=PeptideBrain

# Operator name — surfaced in the brain chat system prompt so the model
# knows who it's talking to. Leave blank to use the generic "the operator".
OPERATOR_NAME=
